# Copy to .env.local and fill. Never commit .env.local.
# All server-side secrets are marked (SERVER) — never expose in `"use client"` files.

# ── Supabase ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://nkefzhgleymxhifpgfcn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_tlp047kX-W-bXIrZFJ_7fQ_LhVR7lzE
SUPABASE_SERVICE_ROLE_KEY=          # SERVER. Copy from Supabase dashboard > Settings > API

# ── Green.Money ────────────────────────────────────────────
GBP_API_BASE=https://www.greenbyphone.com
GBP_CLIENT_ID=                      # SERVER. live Client_ID (provided off-channel)
GBP_API_PASSWORD=                   # SERVER. live API password (provided off-channel)
GBP_CLIENT_ID_SANDBOX=              # SERVER. once requested from Green support
GBP_API_PASSWORD_SANDBOX=           # SERVER. once requested from Green support
GBP_MOCK=true                       # 'true' in dev/CI so we never touch live

# ── Twilio ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=                 # SERVER
TWILIO_AUTH_TOKEN=                  # SERVER
TWILIO_FROM_NUMBER=                 # SERVER. E.164, e.g. +15551234567
KATIE_PHONE_NUMBER=                 # SERVER. E.164
TWILIO_MOCK=true                    # 'true' in dev/CI

# ── Email (Resend) — Phase 1 layer, no-ops until the key lands ──
RESEND_API_KEY=                     # SERVER. Resend project API key (re_…). Empty = email layer no-ops.
RESEND_FROM_EMAIL="ClarivenLabs <noreply@updates.clarivenlabs.com>"   # SERVER. Verified sender on updates.clarivenlabs.com (quote it — the <> breaks bash `source`)
RESEND_REPLY_TO=support@clarivenlabs.com                            # SERVER. Customer replies route here

# ── Rate limiting (Phase 5+) ───────────────────────────────
UPSTASH_REDIS_REST_URL=             # SERVER. Vercel Marketplace > Upstash
UPSTASH_REDIS_REST_TOKEN=           # SERVER

# ── Cron (Phase 6) ─────────────────────────────────────────
CRON_SECRET=                        # SERVER. random 32+ chars, rotated periodically

# ── Leads / membership intake ──────────────────────────────
LEAD_NOTIFY_EMAIL=support@clarivenlabs.com         # SERVER. /contact + home consultation leads land here
MEMBERSHIP_NOTIFY_EMAIL=                            # SERVER. /apply applications → comma-separated (Alicia + Sam); falls back to LEAD_NOTIFY_EMAIL
BOOKING_URL=                                        # Calendly/Cal.com onboarding-call link shown in the welcome email + success screen

# ── DocuSign (agreement e-sign) — mock until creds land ────
DOCUSIGN_MOCK=true                                  # 'true' (or no integration key) → sends are logged to .docusign-log.jsonl, no live send
DOCUSIGN_INTEGRATION_KEY=                           # SERVER. DocuSign integration/JWT key (presence flips healthz to 'configured')
DOCUSIGN_BASE_URL=                                  # SERVER. e.g. https://na4.docusign.net/restapi (account region)
DOCUSIGN_CONSULTING_TEMPLATE_ID=                    # SERVER. template for the Consulting Services Agreement (sent on /apply)
DOCUSIGN_BROKERING_TEMPLATE_ID=                     # SERVER. template for the Peptide Brokering Agreement (from Alletia)

# ── Bank wire (initial engagement fee) — sensitive ─────────
WIRE_BANK_NAME=                                     # SERVER. All four required to send the wire-instructions email; else it's skipped
WIRE_ACCOUNT_NAME=                                  # SERVER
WIRE_ROUTING=                                       # SERVER. ABA routing number
WIRE_ACCOUNT=                                       # SERVER. account number
WIRE_SWIFT=                                         # SERVER. optional, for international wires

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
